{
  "name": "splotify",
  "version": "1.0.0",
  "description": "Local-first music player for iPhone, built with Capacitor",
  "scripts": {
    "ios:www": "node scripts/prepare-ios-www.js",
    "ios:sync": "npm run ios:www && npx cap sync ios",
    "test": "node search-test.js",
    "build:haptics": "esbuild js/haptics-entry.js --bundle --format=iife --minify --outfile=js/vendor/haptics-bridge.js"
  },
  "keywords": ["music", "player", "pwa", "capacitor", "ios"],
  "author": "Skyler Green",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "esbuild": "^0.28.2",
    "music-metadata-browser": "^2.5.11",
    "splotify-audio": "file:plugins/splotify-audio"
  }
}
